server {
    listen 80;
    root /usr/share/nginx/html;
    # index.html 里用 SSI 写出网关加的 Remote-User 请求头。
    ssi on;

    location = /healthz {
        access_log off;
        return 204;
    }

    # 只认核心网关带来的 Remote-User：来源不是核心在这个网络里的地址（WONTON_CORE_ADDRESS，启动时由
    # 官方镜像的 envsubst 换进来）就当没登录，返回 403。网络里的其他容器、别的插件的出网代理都能直连
    # 这个端口，它们带来的请求头一律不认。健康检查走上面的 /healthz，不经这里的校验。
    location / {
        allow ${WONTON_CORE_ADDRESS};
        deny all;
    }
}
