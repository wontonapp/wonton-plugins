#!/usr/bin/env python3
"""查询官方账号登录状态；有记录不代表令牌没有过期。"""
import json
import os
import sys
from pathlib import Path

HOME = Path(os.path.expanduser("~"))
V2 = HOME / ".zcode" / "v2"


def logged_in(family: str) -> bool:
    try:
        credentials = json.loads((V2 / "credentials.json").read_text())
        return bool(credentials.get(f"oauth:{family}:access_token"))
    except (OSError, ValueError, TypeError):
        return False


if len(sys.argv) != 3 or sys.argv[1] != "account" or sys.argv[2] not in ("zai", "bigmodel"):
    print(f"用法：{sys.argv[0]} account zai|bigmodel", file=sys.stderr)
    raise SystemExit(2)
raise SystemExit(0 if logged_in(sys.argv[2]) else 1)
